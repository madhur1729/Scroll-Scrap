{
  "manifest_version": 3,
  "name": "Scroll Slap   ",
  "version": "1.0.0",
  "description": "Break out of doomscrolling with sudden, chaotic interventions.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://www.instagram.com/*",
    "https://www.reddit.com/*",
    "https://reddit.com/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.instagram.com/*",
        "https://www.reddit.com/*",
        "https://reddit.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Scroll Slap"
  },
  "icons": {
    "16": "assets/icon16.svg",
    "48": "assets/icon16.svg",
    "128": "assets/icon16.svg"
  }
}
